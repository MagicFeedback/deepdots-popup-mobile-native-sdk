# Built iOS frameworks — the binary itself exceeds GitHub's 100 MB
# per-file limit and is regenerated by scripts/prepare_sdk_release.sh
# (which reads from shared/build/bin/, not dist/), so it should not
# be tracked. Headers + Info.plist remain tracked for reference.
dist/ios/iosArm64/releaseFramework/ComposeApp.framework/ComposeApp
dist/ios/iosSimulatorArm64/releaseFramework/ComposeApp.framework/ComposeApp
maven_upload_temp/
shared-android-*-maven-ready.zip
iosApp/iosApp/magicfeedback/
